# ─────────────────────────────────────────────────────────
# 상담 자동화(솔라피 알림톡)에 필요한 환경변수 예시
# ⚠️ 이 파일에는 실제 키를 절대 넣지 마세요.
#    실제 값은 Netlify / Vercel 대시보드의 "Environment variables"에만 저장합니다.
# ─────────────────────────────────────────────────────────

# 솔라피 → 개발/연동 → API Key 관리에서 발급
SOLAPI_API_KEY=NCS...
SOLAPI_API_SECRET=...

# 솔라피에 사전 등록한 발신번호 (숫자만 또는 하이픈 포함)
SOLAPI_SENDER=0212345678

# 카카오 비즈니스 채널 연동 후 발급되는 채널 ID
SOLAPI_PFID=KA01PF...

# 승인 완료된 알림톡 템플릿 ID — 3단계 각각 하나씩
SOLAPI_TEMPLATE_ID=KA01TP...          # ① 상담 신청 접수 (구글 신청서 링크)
SOLAPI_TEMPLATE_COMPLETE=KA01TP...    # ② 신청서 작성 완료 안내
SOLAPI_TEMPLATE_RESERVE=KA01TP...     # ③ 상담 예약 확정 (일시 + 준비 내용)

# 구글 폼(Apps Script)이 서버를 부를 때 쓰는 비밀 문자열.
# 아무 문자열이나 길게 만들어 여기와 Apps Script 양쪽에 똑같이 넣으세요.
HOOK_SECRET=길고-아무도-모르는-문자열-1234

# (선택) 상담 장소·기본 준비 내용 — 비우면 코드의 기본값이 나갑니다
PLACE_TEXT=프라미스A 교습소
DEFAULT_PREP=- 상담에는 학생이 함께 와 주세요\n- 지금까지 쓰던 교재와 공부한 것들을 챙겨 오세요

# 구글 상담신청서(구글 폼) 링크 — 알림톡 안에 들어갑니다
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/FORM_ID/viewform

# (선택) 상담 신청이 들어오면 접수 알림 문자를 받을 원장님 번호
OWNER_PHONE=01012345678

# (선택) 안내 문구에 표시할 교습소 전화번호
DISPLAY_TEL=02-1234-5678

# (선택) 이 주소에서 온 요청만 허용 (다른 사이트의 무단 사용 차단)
ALLOWED_ORIGIN=https://promise-a.vercel.app
